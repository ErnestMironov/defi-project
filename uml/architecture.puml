"Strategies Page" --> "Strategies Module"

"Transactions Page" ..> "UI Components"
"Portfolio Page" ..> "UI Components"
"Tokens Page" ..> "UI Components"
"Strategies Page" ..> "UI Components"
"Analytics Page" ..> "UI Components"
"Points Page" ..> "UI Components"

"Transactions Page" ..> "Business Logic"
"Portfolio Page" ..> "Business Logic"
"Tokens Page" ..> "Business Logic"
"Strategies Page" ..> "Business Logic"
"Analytics Page" ..> "Business Logic"
"Points Page" ..> "Business Logic"

@enduml 